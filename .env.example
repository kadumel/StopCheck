# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — Railway define DATABASE_URL automaticamente ao ligar a base de dados
# Formato: postgresql://user:password@host:port/railway
# DATABASE_URL=postgresql://postgres:password@localhost:5432/stopcheck

# Railway (preenchido automaticamente pela plataforma — não é necessário definir manualmente)
# RAILWAY_PUBLIC_DOMAIN=stopcheck-production.up.railway.app
# RAILWAY_ENVIRONMENT=production
# PORT=8000

# Stripe (https://dashboard.stripe.com)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Produção (Railway preenche o domínio via RAILWAY_PUBLIC_DOMAIN)
# DEBUG=False
# CSRF_TRUSTED_ORIGINS=https://stopcheck-production.up.railway.app
